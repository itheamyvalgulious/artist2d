# Copy to .env and `set -a; . ./.env; set +a` (the pipeline reads os.environ only,
# it does not parse .env files itself). Never commit the real file.

# Local NewAPI gateway (OpenAI-compatible) that fronts the Gemini image models.
NEWAPI_BASE=http://127.0.0.1:3000
NEWAPI_KEY=

# Optional model / display overrides.
# PIXEL_MODEL_SUNBURST=gemini-nano-banana-2.1
# PIXEL_MODEL_FLARE=gemini-3.1-flash-lite-image
# PIXEL_MODEL_PRO=gemini-3-pro-image
# VISION_MODEL=gemini-3.8-flash
# GODOT_DISPLAY=:0
# PIXEL_API_CONCURRENCY=3
